# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fleetflow?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=fleetflow_jwt_secure_secret_key_2026_replace_in_prod
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# One-time Admin Bootstrap (Used by: npm run bootstrap:admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@fleetflow.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Admin User

# Setup Authorization Key (Server-side only - never exposed to browser)
INITIAL_SETUP_KEY=your_secure_server_side_setup_key_here
